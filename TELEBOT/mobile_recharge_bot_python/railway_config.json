{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "python polling_bot.py",
    "restartPolicy": {
      "condition": "on-failure",
      "maxRetries": 10
    }
  }
}
